+//   Copyright 2026 The Tari Project
+//   SPDX-License-Identifier: BSD-3-Clause
+
+//! Wallet-level tests for a minimum-value-promise-bearing output requested through the normal
+//! statement RPC.
+//!
+//! The question is whether a relying site can get the output a threshold access proof needs out of an
+//! unmodified request/response cycle. Everything runs against a real wallet — a real SQLite store, a
+//! real key manager, a real cipher seed, a real account with an owner key — with only the indexer
+//! network interface offline, because the handler resolves its inputs locally.
+//!
+//! What is established here:
+//! - the caller-requested promise reaches the statement the wallet hands back;
+//! - the resulting statement is one the engine's own transfer validator accepts;
+//! - the inputs are selected, locked and left locked under the returned lock;
+//! - the wallet returns signer metadata and no key material;
+//! - an unsatisfiable promise is refused before any lock is taken.
+//!
+//! Acceptance by a live validator is a separate question, and is not answered here.
+
+use tari_template_lib_types::stealth::SpendWitness;
+
+use super::*;
+
+/// The point of the feature: a caller names a promise and the wallet honours it.
+///
+/// Deliberately fragmented across three wallet-owned, key-path stealth UTXOs rather than funded as a
+/// single coin, because a fragmented UTXO set is the normal case for a real wallet.
+#[tokio::test]
+async fn requested_promise_reaches_the_wallet_built_statement() {
+    const THRESHOLD: u64 = 10_000;
+
+    let test = setup().await;
+    let bearer = test.bearer(&test.transfer_and_read_scopes());
+
+    let inputs: Vec<_> = (0u64..3).map(|i| insert_valid_output(&test, 4_000 + i)).collect();
+
+    let request = AccountsCreateStealthTransferStatementRequest {
+        requests: vec![TransferStatementRequest {
+            sender_account: test.account.into(),
+            resource_address: test.stealth_resource,
+            input_selection: InputSelection::Specific {
+                utxo_addresses: inputs.iter().map(|o| o.to_utxo_address()).collect(),
+            },
+            outputs: vec![TransferOutput {
+                address: account_ootle_address(&test),
+                revealed_amount: Amount::zero(),
+                blinded_amount: 12_003,
+                memo: None,
+                pay_to: PayTo::StealthPublicKey,
+                minimum_value_promise: THRESHOLD,
+            }],
+        }],
+    };
+
+    let response = handle_create_stealth_transfer_statement(&test.context, Some(&bearer), request)
+        .await
+        .expect("a valid, balanced request should succeed");
+
+    assert_eq!(response.statements.len(), 1);
+    let statement = &response.statements[0];
+
+    assert_eq!(statement.outputs_statement.outputs.len(), 1);
+    assert_eq!(
+        statement.outputs_statement.outputs[0].output.minimum_value_promise, THRESHOLD,
+        "the caller-requested promise must reach the statement the wallet returns"
+    );
+
+    // The engine's own validator accepts it. A promise above the hidden value could not have been
+    // proven at all, so reaching this point is itself evidence the bound is real.
+    tari_engine_types::stealth::validate_transfer(statement, None)
+        .expect("the engine's transfer validator must accept the promised statement");
+
+    // All three fragmented inputs fund the one statement.
+    assert_eq!(statement.inputs_statement.inputs.len(), 3);
+    assert!(statement.balance_proof.is_some(), "value conservation must be proven");
+
+    // Nothing was revealed: a promise publishes a bound, not an amount.
+    assert!(statement.outputs_statement.revealed_output.is_none());
+    assert!(statement.inputs_statement.revealed_amount.is_zero());
+}
+
+/// A caller that never heard of the field still gets a zero promise, so every existing wallet client
+/// keeps working and keeps publishing nothing.
+#[tokio::test]
+async fn a_caller_that_omits_the_promise_gets_zero() {
+    let test = setup().await;
+    let bearer = test.bearer(&test.transfer_and_read_scopes());
+    let input = insert_valid_output(&test, 300);
+
+    let request = AccountsCreateStealthTransferStatementRequest {
+        requests: vec![TransferStatementRequest {
+            sender_account: test.account.into(),
+            resource_address: test.stealth_resource,
+            input_selection: InputSelection::Specific {
+                utxo_addresses: vec![input.to_utxo_address()],
+            },
+            outputs: vec![TransferOutput {
+                address: account_ootle_address(&test),
+                revealed_amount: Amount::zero(),
+                blinded_amount: 300,
+                memo: None,
+                pay_to: PayTo::StealthPublicKey,
+                minimum_value_promise: 0,
+            }],
+        }],
+    };
+
+    let response = handle_create_stealth_transfer_statement(&test.context, Some(&bearer), request)
+        .await
+        .expect("unchanged behaviour for a caller that asks for no promise");
+
+    assert_eq!(
+        response.statements[0].outputs_statement.outputs[0]
+            .output
+            .minimum_value_promise,
+        0
+    );
+}
+
+/// A promise larger than the output's value cannot be proven: the bulletproof would attest
+/// `value ∈ [mvp, 2^64)` with no value satisfying it, so no validator could accept the transaction.
+///
+/// The handler must refuse it *before* locking, or the caller would end up with inputs locked
+/// against a statement that can never be used.
+#[tokio::test]
+async fn an_unsatisfiable_promise_is_refused_without_locking() {
+    let test = setup().await;
+    let bearer = test.bearer(&test.transfer_and_read_scopes());
+    let input = insert_valid_output(&test, 300);
+
+    let request = AccountsCreateStealthTransferStatementRequest {
+        requests: vec![TransferStatementRequest {
+            sender_account: test.account.into(),
+            resource_address: test.stealth_resource,
+            input_selection: InputSelection::Specific {
+                utxo_addresses: vec![input.to_utxo_address()],
+            },
+            outputs: vec![TransferOutput {
+                address: account_ootle_address(&test),
+                revealed_amount: Amount::zero(),
+                blinded_amount: 300,
+                memo: None,
+                pay_to: PayTo::StealthPublicKey,
+                minimum_value_promise: 301,
+            }],
+        }],
+    };
+
+    let err = handle_create_stealth_transfer_statement(&test.context, Some(&bearer), request)
+        .await
+        .expect_err("an unsatisfiable promise must be refused");
+
+    let text = err.to_string();
+    assert!(
+        text.contains("minimum_value_promise"),
+        "the error must name the field the caller set, got: {text}"
+    );
+
+    // The input is untouched: no lock was taken for a request that can never succeed.
+    let stored = stored_output(&test, &input.commitment);
+    assert!(
+        matches!(stored.status, OutputStatus::Unspent),
+        "a refused request must leave the input spendable, got {:?}",
+        stored.status
+    );
+    assert_eq!(stored.lock_id, None);
+}
+
+/// The response carries the metadata the wallet needs to sign later, and no key material.
+///
+/// This is the property the whole design rests on: a caller assembles bytes, the wallet supplies
+/// authority. `utxo_signers` names each spent output's public nonce so the wallet can derive the
+/// matching per-UTXO spend key on the caller's behalf; neither that nor a `KeyId` is a secret.
+#[tokio::test]
+async fn the_response_carries_signer_metadata_and_no_secrets() {
+    let test = setup().await;
+    let bearer = test.bearer(&test.transfer_and_read_scopes());
+    let inputs: Vec<_> = (0u64..2).map(|i| insert_valid_output(&test, 5_000 + i)).collect();
+
+    let request = AccountsCreateStealthTransferStatementRequest {
+        requests: vec![TransferStatementRequest {
+            sender_account: test.account.into(),
+            resource_address: test.stealth_resource,
+            input_selection: InputSelection::Specific {
+                utxo_addresses: inputs.iter().map(|o| o.to_utxo_address()).collect(),
+            },
+            outputs: vec![TransferOutput {
+                address: account_ootle_address(&test),
+                revealed_amount: Amount::zero(),
+                blinded_amount: 10_001,
+                memo: None,
+                pay_to: PayTo::StealthPublicKey,
+                minimum_value_promise: 10_000,
+            }],
+        }],
+    };
+
+    let response = handle_create_stealth_transfer_statement(&test.context, Some(&bearer), request)
+        .await
+        .expect("valid request");
+
+    // One signer per spent output, in the order requested, each naming only public data.
+    assert_eq!(response.utxo_signers.len(), 2);
+    for (signer, output) in response.utxo_signers.iter().zip(&inputs) {
+        assert_eq!(signer.public_nonce, output.sender_public_nonce);
+    }
+
+    // The wallet names its own signing key; the private half never leaves the keyring.
+    assert!(
+        !response.signing_keys.is_empty(),
+        "the wallet must name the signing key it will use"
+    );
+
+    // The spent inputs are locked under the returned lock, ready for `transactions.submit`.
+    for output in &inputs {
+        let stored = stored_output(&test, &output.commitment);
+        assert!(matches!(stored.status, OutputStatus::LockedForSpend));
+        assert_eq!(stored.lock_id, Some(response.lock_id));
+    }
+}
+
+/// The statement a wallet produces for a threshold request is shaped the way the engine and a
+/// threshold gate require: exactly one key-spendable stealth output, no revealed amounts, a balance
+/// proof, and every input spent on the key path.
+#[tokio::test]
+async fn a_promised_statement_has_the_shape_a_gate_requires() {
+    let test = setup().await;
+    let bearer = test.bearer(&test.transfer_and_read_scopes());
+    let input = insert_valid_output(&test, 20_000);
+
+    let request = AccountsCreateStealthTransferStatementRequest {
+        requests: vec![TransferStatementRequest {
+            sender_account: test.account.into(),
+            resource_address: test.stealth_resource,
+            input_selection: InputSelection::Specific {
+                utxo_addresses: vec![input.to_utxo_address()],
+            },
+            outputs: vec![TransferOutput {
+                address: account_ootle_address(&test),
+                revealed_amount: Amount::zero(),
+                blinded_amount: 20_000,
+                memo: None,
+                pay_to: PayTo::StealthPublicKey,
+                minimum_value_promise: 10_000,
+            }],
+        }],
+    };
+
+    let response = handle_create_stealth_transfer_statement(&test.context, Some(&bearer), request)
+        .await
+        .expect("valid request");
+    let statement = &response.statements[0];
+
+    assert_eq!(statement.outputs_statement.outputs.len(), 1);
+    assert!(statement.outputs_statement.revealed_output.is_none());
+    assert!(statement.inputs_statement.revealed_amount.is_zero());
+    assert!(statement.balance_proof.is_some());
+    assert!(
+        statement
+            .inputs_statement
+            .inputs
+            .iter()
+            .all(|i| i.witness == SpendWitness::KeyPath),
+        "ordinary wallet funds spend on the key path"
+    );
+    assert!(
+        statement.outputs_statement.outputs[0].auth.spend_key().is_some(),
+        "the qualifying output must be key-spendable so the funds stay under the owner's control"
+    );
+    assert!(
+        statement.outputs_statement.outputs[0].output.minimum_value_promise >= 10_000,
+        "the promised bound must clear the gate threshold"
+    );
+}
