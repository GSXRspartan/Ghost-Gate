+//   Copyright 2026 The Tari Project
+//   SPDX-License-Identifier: BSD-3-Clause
+
+//! Tests for the caller-requested `minimum_value_promise` on a wallet transfer output.
+//!
+//! The promise is a public lower bound on a blinded output's hidden value, covered by that output's
+//! bulletproof. Zero publishes nothing and is what an ordinary transfer wants. A non-zero value lets
+//! a caller commit, in zero knowledge, to holding at least that much — which is what a threshold
+//! access proof needs and what an ordinary transfer cannot express.
+
+use ootle_byte_type::ToByteType;
+use tari_crypto::{
+    keys::{PublicKey as _, SecretKey as _},
+    ristretto::{RistrettoPublicKey, RistrettoSecretKey},
+};
+use tari_engine_types::stealth::validate_stealth_outputs_statement;
+use tari_ootle_wallet_crypto::{stealth, MaskAndValue, OutputWitness, StealthInputWitness, StealthOutputWitness};
+use tari_template_lib::types::{
+    constants::STEALTH_TARI_RESOURCE_ADDRESS,
+    crypto::UtxoTag,
+    stealth::{SpendAuthorization, StealthTransferStatement},
+    Amount,
+    EncryptedData,
+};
+
+use super::*;
+
+const NETWORK: Network = Network::LocalNet;
+
+fn address() -> OotleAddress {
+    let (_, view_only) = RistrettoPublicKey::random_keypair(&mut rand::rng());
+    let (_, account) = RistrettoPublicKey::random_keypair(&mut rand::rng());
+    OotleAddress::new(NETWORK, view_only.to_byte_type(), account.to_byte_type())
+}
+
+fn output(blinded_amount: u64, minimum_value_promise: u64) -> TransferOutput {
+    TransferOutput {
+        address: address(),
+        revealed_amount: Amount::zero(),
+        blinded_amount,
+        memo: None,
+        pay_to: PayTo::StealthPublicKey,
+        minimum_value_promise,
+    }
+}
+
+fn params_with(blinded_amount: u64, minimum_value_promise: u64) -> StealthTransferParams {
+    StealthTransferParams {
+        max_epoch: Epoch(1),
+        fee_params: TransferFeeParams::new(UtxoInputSelection::PreferConfidential),
+        input_selection: UtxoInputSelection::PreferConfidential,
+        outputs: vec![output(blinded_amount, minimum_value_promise)],
+        badge_usage: BadgeUsage::None,
+        resource_address: STEALTH_TARI_RESOURCE_ADDRESS,
+        max_fee: 1000,
+        is_dry_run: false,
+    }
+}
+
+// --------------------------------------------------------------------------------------------
+// Backward compatibility
+// --------------------------------------------------------------------------------------------
+
+/// A caller that does not mention the field at all still gets zero: the promise is opt-in, so
+/// existing RPC clients keep working and keep publishing nothing.
+#[test]
+fn an_omitted_promise_defaults_to_zero() {
+    let json = serde_json::json!({
+        "address": address().to_string(),
+        "revealed_amount": "0",
+        "blinded_amount": "100",
+        "memo": null,
+        "pay_to": { "StealthPublicKey": null },
+    });
+    let parsed: TransferOutput = serde_json::from_value(json).expect("a caller omitting the field must still parse");
+    assert_eq!(parsed.minimum_value_promise, 0);
+}
+
+/// A promise as a JSON string must parse, matching how every other u64 in this type is carried.
+#[test]
+fn a_string_encoded_promise_parses() {
+    let json = serde_json::json!({
+        "address": address().to_string(),
+        "revealed_amount": "0",
+        "blinded_amount": "100",
+        "minimum_value_promise": "10000",
+        "memo": null,
+        "pay_to": { "StealthPublicKey": null },
+    });
+    let parsed: TransferOutput = serde_json::from_value(json).expect("a string-encoded u64 must parse");
+    assert_eq!(parsed.minimum_value_promise, 10_000);
+}
+
+// --------------------------------------------------------------------------------------------
+// Validation
+// --------------------------------------------------------------------------------------------
+
+/// Zero leaves existing behaviour untouched: this is the field every current caller gets.
+#[test]
+fn a_zero_promise_is_accepted() {
+    params_with(100, 0)
+        .validate(NETWORK)
+        .expect("zero promises no lower bound and cannot be unsatisfiable");
+}
+
+/// A promise below the value is exactly the intended use.
+#[test]
+fn a_promise_below_the_amount_is_accepted() {
+    params_with(30_000, 10_000)
+        .validate(NETWORK)
+        .expect("a promise below the value is provable");
+}
+
+/// A promise equal to the value is the tightest satisfiable bound.
+#[test]
+fn a_promise_equal_to_the_amount_is_accepted() {
+    params_with(10_000, 10_000)
+        .validate(NETWORK)
+        .expect("value ∈ [mvp, 2^64) is satisfied at the boundary");
+}
+
+/// A promise above the value cannot be proven: the bulletproof would attest value ∈ [mvp, 2^64)
+/// with no value satisfying it, so no validator could ever accept it. Rejected here, before any
+/// input is locked, and reported against the field the caller set.
+#[test]
+fn a_promise_above_the_amount_is_rejected_before_submission() {
+    let err = params_with(10_000, 10_001)
+        .validate(NETWORK)
+        .expect_err("an unsatisfiable promise must be rejected");
+    match err {
+        StealthTransferApiError::InvalidParameter { param, reason } => {
+            assert_eq!(param, "minimum_value_promise");
+            assert!(reason.contains("10001"), "{reason}");
+            assert!(reason.contains("10000"), "{reason}");
+        },
+        other => panic!("expected InvalidParameter naming minimum_value_promise, got: {other}"),
+    }
+}
+
+/// The bound is against the blinded amount alone: a revealed amount is already public, so allowing
+/// it to carry the promise would let a caller inflate a bound about hidden funds with money that
+/// is not hidden.
+#[test]
+fn a_promise_is_bounded_by_the_blinded_amount_not_the_total() {
+    let params = StealthTransferParams {
+        outputs: vec![TransferOutput {
+            revealed_amount: Amount::from(1_000_000u64),
+            ..output(100, 500)
+        }],
+        ..params_with(100, 0)
+    };
+    let err = params
+        .validate(NETWORK)
+        .expect_err("a revealed amount must not be able to carry the promise");
+    assert!(matches!(err, StealthTransferApiError::InvalidParameter {
+        param: "minimum_value_promise",
+        ..
+    }));
+}
+
+/// The largest promise is still just a `u64` comparison — no arithmetic, so no overflow path.
+#[test]
+fn the_largest_promise_is_bounded_by_the_amount() {
+    let err = params_with(10_000, u64::MAX)
+        .validate(NETWORK)
+        .expect_err("u64::MAX cannot be bounded by 10_000");
+    assert!(matches!(err, StealthTransferApiError::InvalidParameter {
+        param: "minimum_value_promise",
+        ..
+    }));
+}
+
+/// A revealed-only output carries no hidden value, so a promise on one is meaningless and the
+/// blinded-amount bound of zero is what applies.
+#[test]
+fn a_promise_on_a_revealed_only_output_is_rejected() {
+    let params = StealthTransferParams {
+        outputs: vec![TransferOutput {
+            revealed_amount: Amount::from(100u64),
+            blinded_amount: 0,
+            ..output(0, 1)
+        }],
+        ..params_with(0, 0)
+    };
+    assert!(params.validate(NETWORK).is_err());
+}
+
+// --------------------------------------------------------------------------------------------
+// The promise reaches the statement
+// --------------------------------------------------------------------------------------------
+
+/// A key-path output witness worth `amount` promising at least `promise`.
+fn promised_output(amount: u64, promise: u64) -> StealthOutputWitness {
+    let mask = RistrettoSecretKey::random(&mut rand::rng());
+    StealthOutputWitness {
+        witness: OutputWitness {
+            amount,
+            mask: mask.clone(),
+            sender_public_nonce: RistrettoPublicKey::random_keypair(&mut rand::rng()).1,
+            minimum_value_promise: promise,
+            encrypted_data: EncryptedData::try_from(vec![0u8; EncryptedData::min_size()]).unwrap(),
+            resource_view_key: None,
+        },
+        auth: SpendAuthorization::Key(RistrettoPublicKey::from_secret_key(&mask).to_byte_type()),
+        tag: UtxoTag::new(0),
+    }
+}
+
+/// A single-input statement whose output promises `promise`, built the way
+/// `create_output_witness` builds one.
+fn promised_statement(amount: u64, promise: u64) -> StealthTransferStatement {
+    promised_statement_from_inputs(amount, promise, &[amount])
+}
+
+/// The same, funded by several fragmented inputs.
+fn promised_statement_from_inputs(amount: u64, promise: u64, input_values: &[u64]) -> StealthTransferStatement {
+    let out = promised_output(amount, promise);
+    let inputs: Vec<StealthInputWitness> = input_values
+        .iter()
+        .map(|value| {
+            StealthInputWitness::new(MaskAndValue {
+                mask: RistrettoSecretKey::random(&mut rand::rng()),
+                value: *value,
+            })
+        })
+        .collect();
+    stealth::create_transfer_statement(inputs, Amount::zero(), [&out], None)
+        .expect("the promise is below the value, so the statement builds")
+}
+
+/// The promise must reach both the statement's public field and the bulletproof. A witness that
+/// carried the value but a statement that dropped it would publish a bound nothing backs.
+#[test]
+fn the_generated_statement_carries_the_requested_promise() {
+    let statement = promised_statement(30_000, 10_000);
+    assert_eq!(statement.outputs_statement.outputs.len(), 1);
+    assert_eq!(
+        statement.outputs_statement.outputs[0].output.minimum_value_promise, 10_000,
+        "the caller-requested promise must reach the statement's public field"
+    );
+}
+
+/// A promised statement must pass the engine's own range-proof validation, or the promise is
+/// decorative.
+#[test]
+fn a_promised_statement_validates_against_the_engine() {
+    let statement = promised_statement(30_000, 10_000);
+    validate_stealth_outputs_statement(&statement.outputs_statement, None)
+        .expect("the engine must accept a proof that covers the promised bound");
+}
+
+/// The promise is bound into the bulletproof. Changing it after generation must invalidate the
+/// proof in both directions: lowering would let a sub-threshold holder pass, raising would be a
+/// forgery.
+#[test]
+fn mutating_the_promise_after_generation_invalidates_the_proof() {
+    let mut statement = promised_statement(30_000, 10_000);
+
+    statement.outputs_statement.outputs[0].output.minimum_value_promise = 9_999;
+    assert!(
+        validate_stealth_outputs_statement(&statement.outputs_statement, None).is_err(),
+        "lowering the promise must invalidate the range proof"
+    );
+
+    statement.outputs_statement.outputs[0].output.minimum_value_promise = 40_000;
+    assert!(
+        validate_stealth_outputs_statement(&statement.outputs_statement, None).is_err(),
+        "raising the promise must invalidate the range proof"
+    );
+}
+
+/// The promised value stays hidden. The output body exposes a commitment and the promise, never the
+/// amount, so two holders clearing the same bound produce indistinguishable public data.
+#[test]
+fn a_promised_statement_reveals_no_amount() {
+    let small = promised_statement(10_000, 10_000);
+    let large = promised_statement(9_000_000, 10_000);
+
+    for statement in [&small, &large] {
+        assert!(statement.outputs_statement.revealed_output.is_none());
+        assert!(statement.inputs_statement.revealed_amount.is_zero());
+    }
+
+    // A 900x difference in hidden value, identical public bound.
+    assert_eq!(
+        small.outputs_statement.outputs[0].output.minimum_value_promise,
+        large.outputs_statement.outputs[0].output.minimum_value_promise
+    );
+    assert_ne!(
+        small.outputs_statement.outputs[0].output.commitment, large.outputs_statement.outputs[0].output.commitment,
+        "the commitments differ, so the amounts are not equal"
+    );
+}
+
+/// Fragmented inputs are unaffected: the promise is a property of the output, not of how many
+/// inputs funded it.
+#[test]
+fn fragmented_inputs_carry_the_promise_unchanged() {
+    let statement = promised_statement_from_inputs(12_300, 10_000, &[3_100, 2_900, 4_800, 1_500]);
+    assert_eq!(statement.inputs_statement.inputs.len(), 4);
+    assert_eq!(statement.outputs_statement.outputs.len(), 1);
+    assert_eq!(
+        statement.outputs_statement.outputs[0].output.minimum_value_promise, 10_000,
+        "one promise, four inputs"
+    );
+    validate_stealth_outputs_statement(&statement.outputs_statement, None)
+        .expect("a promised output from fragmented inputs must still validate");
+}
+
+/// `TryFrom<&TransferOutput>` must carry the field, or the RPC path would silently drop it.
+#[test]
+fn the_rpc_conversion_carries_the_promise() {
+    // The conversion borrows (`StealthOutputToCreate<'a>` holds `memo: Option<&'a Memo>`), so the
+    // source has to outlive it — binding the temporary to a local first.
+    let requested = output(30_000, 10_000);
+    let converted = StealthOutputToCreate::try_from(&requested).expect("conversion");
+    assert_eq!(converted.minimum_value_promise, 10_000);
+    assert_eq!(converted.amount, 30_000);
+}
+
+/// Nothing on this path returns key material. The promise is a public field on a witness whose
+/// secret parts (mask, and the spend key the owner holds) never appear in the statement the caller
+/// receives, so the caller can request a bound without being able to spend the output.
+#[test]
+fn the_statement_carries_no_secret_material() {
+    let statement = promised_statement(30_000, 10_000);
+    let encoded = tari_bor::encode(&statement).expect("statement encodes");
+    let decoded: StealthTransferStatement = tari_bor::decode(&encoded).expect("round trip");
+
+    assert_eq!(decoded, statement);
+    for output in &decoded.outputs_statement.outputs {
+        // Only public forms are present. A mask would let anyone decrypt the output; a spend secret
+        // would let anyone spend it.
+        let _: &tari_template_lib::types::crypto::PedersenCommitmentBytes = &output.output.commitment;
+        let _: &tari_template_lib::types::crypto::RistrettoPublicKeyBytes = &output.output.sender_public_nonce;
+        let _: &EncryptedData = &output.output.encrypted_data;
+        assert!(
+            matches!(output.auth, SpendAuthorization::Key(_)),
+            "a key-path output's auth is the public spend key, never its secret half"
+        );
+    }
+}
+
+/// Two outputs may carry different promises, so a caller could split funds across bounds. Asserted
+/// so that a future single-value shortcut cannot silently collapse them.
+#[test]
+fn per_output_promises_are_independent() {
+    let a = promised_output(20_000, 5_000);
+    let b = promised_output(10_000, 10_000);
+    assert_eq!(a.witness.minimum_value_promise, 5_000);
+    assert_eq!(b.witness.minimum_value_promise, 10_000);
+
+    let statement = stealth::create_transfer_statement(
+        [StealthInputWitness::new(MaskAndValue {
+            mask: RistrettoSecretKey::random(&mut rand::rng()),
+            value: 30_000,
+        })],
+        Amount::zero(),
+        [&a, &b],
+        None,
+    )
+    .expect("statement builds");
+
+    let promises: Vec<u64> = statement
+        .outputs_statement
+        .outputs
+        .iter()
+        .map(|o| o.output.minimum_value_promise)
+        .collect();
+    assert_eq!(promises, vec![5_000, 10_000]);
+    validate_stealth_outputs_statement(&statement.outputs_statement, None)
+        .expect("both promises are covered by the aggregated proof");
+}
