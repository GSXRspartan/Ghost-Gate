+                return Err(StealthTransferApiError::InvalidParameter {
+                    param: "minimum_value_promise",
+                    reason: format!(
+                        "minimum_value_promise ({}) must not exceed blinded_amount ({})",
+                        output.minimum_value_promise, output.blinded_amount
+                    ),
+                });
+            }
         }
 
         // A TARI transfer may select inputs covering the outputs and the fee together.
@@ -160,6 +171,18 @@ pub struct TransferOutput {
     /// Optional memo to include a memo in the output. This memo is encrypted and can only be read by the recipient.
     pub memo: Option<Memo>,
     pub pay_to: PayTo,
+    /// Public lower bound covered by the blinded output's range proof.
+    ///
+    /// Zero is the ordinary-transfer default and publishes no positive lower bound. A non-zero
+    /// value must not exceed `blinded_amount`.
+    #[serde(default)]
+    #[serde(deserialize_with = "ootle_serde::str_number::deserialize")]
+    #[cfg_attr(feature = "ts", ts(type = "number | bigint | string"))]
+    pub minimum_value_promise: u64,
 }
 
 impl TransferOutput {
@@ -270,6 +293,7 @@ impl<'a> TryFrom<&'a TransferOutput> for StealthOutputToCreate<'a> {
             amount: value.blinded_amount,
             memo: value.memo.as_ref(),
             pay_to: value.pay_to.clone(),
+            minimum_value_promise: value.minimum_value_promise,
         })
     }
 }
@@ -370,6 +394,7 @@ mod tests {
                 blinded_amount,
                 memo: None,
                 pay_to,
+                minimum_value_promise: 0,
             }],
