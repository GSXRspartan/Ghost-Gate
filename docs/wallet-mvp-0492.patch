+                    minimum_value_promise: 0,
                 })
                 .collect(),
             max_fee,
@@ -519,7 +545,49 @@ mod tests {
     #[test]
     fn accepts_a_well_formed_condition_set() {
         blinded_paying_to(PayTo::Conditions(vec![a_condition(1), a_condition(2)]))
             .validate(NETWORK)
             .expect("distinct condition leaves form a tree");
     }
+
+    #[test]
+    fn omitted_minimum_value_promise_defaults_to_zero() {
+        let value = serde_json::json!({
+            "address": address().to_string(),
+            "revealed_amount": "0",
+            "blinded_amount": "100",
+            "memo": null,
+            "pay_to": "StealthPublicKey"
+        });
+        let output: TransferOutput = serde_json::from_value(value).unwrap();
+        assert_eq!(output.minimum_value_promise, 0);
+    }
+
+    #[test]
+    fn minimum_value_promise_at_or_below_blinded_amount_is_accepted() {
+        let mut params = params_paying_to(100, 0, PayTo::StealthPublicKey);
+        params.outputs[0].minimum_value_promise = 100;
+        params.validate(NETWORK).unwrap();
+
+        params.outputs[0].minimum_value_promise = 99;
+        params.validate(NETWORK).unwrap();
+    }
+
+    #[test]
+    fn minimum_value_promise_above_blinded_amount_is_rejected() {
+        let mut params = params_paying_to(100, 0, PayTo::StealthPublicKey);
+        params.outputs[0].minimum_value_promise = 101;
+        let err = params.validate(NETWORK).unwrap_err();
+        assert!(matches!(
+            err,
+            StealthTransferApiError::InvalidParameter {
+                param: "minimum_value_promise",
+                ..
+            }
+        ));
+    }
 }
