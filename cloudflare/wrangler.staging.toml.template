# Copy to wrangler.staging.toml, replace the two non-secret placeholders, then
# deploy with `wrangler deploy --config wrangler.staging.toml`. Do not deploy
# this file as the production Worker and do not put secrets in it.
name = "ghost-gate-staging"
main = "src/worker.js"
compatibility_date = "2026-10-23"

[assets]
# Generated by scripts/prepare-staging-web.ps1. It carries exact bridge and
# claim origins for Telegram links; the checked-in web directory remains safe
# for local development because its trusted-origin metas are blank.
directory = "../staging-web"
binding = "ASSETS"
run_worker_first = true

[[durable_objects.bindings]]
name = "REPLAY_COORDINATOR"
class_name = "ReplayCoordinator"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["ReplayCoordinator"]

[vars]
# An exact HTTPS Worker origin is required in every catalog entry. This value
# is public configuration, but must describe only the staging gate.
GG_GATE_CATALOG = 'REPLACE_WITH_STAGING_GATE_CATALOG'
# Exact HTTPS origin of the bridge tunnel; never use a suffix, redirector, or
# arbitrary browser-provided destination.
GG_VERIFIER_ORIGIN = "https://BRIDGE_STAGING_DOMAIN_HERE"

# Set staging-only secrets out of source control:
#   GG_COORDINATOR_TOKEN
#   GG_VERIFIER_TOKEN
#   GG_VERIFIER_REQUEST_KEY
#   GG_VERIFIER_RESPONSE_KEY
