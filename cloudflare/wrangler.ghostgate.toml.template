# ghostgate.boo restricted-staging configuration.  Copy this to a local ignored file such as
# wrangler.ghostgate.toml, render GG_GATE_CATALOG from the VPS's *published* bindings.json, and
# use it only after the Cloudflare custom-domain change has been manually approved.
#
# Keeping the existing script name, Durable Object binding, class name, and v1 migration is
# deliberate: a migration to ghostgate.boo must reuse the existing ReplayCoordinator namespace;
# it must never create a replacement replay database or discard replay history.
name = "ghost-gate-staging"
main = "src/worker.js"
compatibility_date = "2026-10-23"

[assets]
# Generated by scripts/prepare-staging-web.ps1 with WorkerOrigin=https://ghostgate.boo.
# The generated assets bind Telegram's bridge and claim links to exact HTTPS origins.
directory = "../staging-web"
binding = "ASSETS"
run_worker_first = true

[[durable_objects.bindings]]
name = "REPLAY_COORDINATOR"
class_name = "ReplayCoordinator"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["ReplayCoordinator"]

# This is the one Cloudflare custom-domain operation.  Do not deploy it until the operator has
# approved the public hostname, confirmed the Worker route in the dashboard, and retained a
# pre-change deployment rollback target.
[[routes]]
pattern = "ghostgate.boo"
custom_domain = true

[vars]
# Paste the JSON emitted by scripts/render-worker-catalog.ps1.  It must contain the current
# immutable policyVersion and policyHash from bindings.json; hand-authored or draft catalogs are
# unsafe and are refused by the renderer.
GG_GATE_CATALOG = 'REPLACE_WITH_RENDERED_GHOSTGATE_BOO_CATALOG'
GG_VERIFIER_ORIGIN = "https://bridge.ghostgate.boo"

# Optional.  When absent, /bot serves instructions and cannot redirect anywhere.  When supplied,
# it must be exactly https://t.me/<official_bot_username>, with no query, fragment, port, or path.
# GG_TELEGRAM_BOT_URL = "https://t.me/REPLACE_WITH_OFFICIAL_BOT_USERNAME"

# Set only as staging secrets, never in this file or an archive:
#   GG_COORDINATOR_TOKEN
#   GG_VERIFIER_TOKEN
#   GG_VERIFIER_REQUEST_KEY
#   GG_VERIFIER_RESPONSE_KEY
