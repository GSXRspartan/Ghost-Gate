# Keep build artifacts out of the repo.
target/
_cargo-target/

# Never commit keys, wallets or databases.
*.sqlite
*.sqlite3
*.db
keys.json
*.key
.env
.env.*
.ghost-gate/

# Editor / OS noise
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Local test scratch
temp/
/tmp/
*.log
npm-debug.log*
node_modules/
.wrangler/
.pnpm-store/
# Generated staging assets and source packages are deployment artifacts, not source.
/staging-web/
/artifacts/
# Machine-local Cargo config (absolute target-dir path; see the file for why)
/.cargo/
.tari-v047-reference/
