[Unit]
Description=Ghost Gate Bridge (Esmeralda credential verification)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ghostgate-bridge
Group=ghostgate-bridge
SupplementaryGroups=ghostgate-registry
WorkingDirectory=/opt/ghost-gate
ExecStart=/opt/ghost-gate/bin/ghost-gate-bridge
EnvironmentFile=/opt/ghost-gate/etc/ghost-gate-bridge.env
Restart=on-failure
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
LockPersonality=yes
UMask=0077
ReadWritePaths=/opt/ghost-gate/data/registry /opt/ghost-gate/data/replays
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ghost-gate-bridge

[Install]
WantedBy=multi-user.target
