# Ghost Gate VPS Environment Configuration
# Copy to /opt/ghost-gate/etc/ghost-gate.env and fill in secrets.
# Permissions: 0640 owned by root:ghostgate

# ── Bridge ──────────────────────────────────────────────────────────────────
# Loopback only. cloudflared tunnel handles public HTTPS.
GG_BRIDGE_BIND=127.0.0.1:7899

# Permitted browser origins. The CF Worker's public domain, plus the tunneled
# bridge domain (for Telegram join pages that talk to bridge routes directly).
# Comma-separated exact origins.
GG_BRIDGE_ORIGINS=https://WORKER_DOMAIN_HERE,https://BRIDGE_TUNNEL_DOMAIN_HERE

# Gate definition: credential-only (no component), Esmeralda network.
# Format: id=gate_address:resource_address:threshold:divisibility:symbol
# Empty gate_address = credential-only gate.
GG_BRIDGE_GATES=crypt=:resource_0101010101010101010101010101010101010101010101010101010101010101:10000000:6:tTARI

# Esmeralda network byte
GG_OOTLE_NETWORK=0x26

# Gate scoped for both website and Telegram
GG_GATE_USE_CRYPT=both

# Registry-backed access (admin plane published these bindings).
# Point at the data directory containing bindings.json.
GG_BINDINGS_PATH=/opt/ghost-gate/data/registry

# Durable replay store (one JSON file per challenge nonce).
GG_REPLAY_STORE_PATH=/opt/ghost-gate/data/replays

# Esmeralda indexer for credential verification (Mode B chain reads).
GG_INDEXER_ENDPOINT=https://ootle-indexer-a.tari.com

# The indexer's verified flag supports OperatorTrustedTestnet sessions.
GG_OPERATOR_TRUSTED_INDEXER=1

# Cap at OperatorTrustedTestnet — never promote to Production.
GG_MAX_TRUST_TIER=operator-trusted-testnet

# No walletd needed for credential-only verification.
# GG_WALLETD_ENDPOINT is intentionally unset.

# Additional hostnames the bridge accepts in the Host header.
# Required for Cloudflare Tunnel (cloudflared passes the tunnel hostname).
GG_BRIDGE_PERMITTED_HOSTS=BRIDGE_TUNNEL_DOMAIN_HERE

# Hosted verifier adapter: bearer token + HMAC keys for the CF Worker → bridge path.
# The Worker's trustedVerify() calls POST /v1/hosted/verify through the tunnel.
GG_VERIFIER_TOKEN=REPLACE_WITH_VERIFIER_TOKEN
GG_VERIFIER_REQUEST_KEY=REPLACE_WITH_VERIFIER_REQUEST_KEY
GG_VERIFIER_RESPONSE_KEY=REPLACE_WITH_VERIFIER_RESPONSE_KEY

# ── Telegram Bot ────────────────────────────────────────────────────────────
# NEVER commit or log this token.
GG_TG_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN

# Ghost Gate Test Lab supergroup
GG_TG_CHAT_ID=-1003979379260

# The bridge is on localhost (same VPS).
GG_BRIDGE_ENDPOINT=http://127.0.0.1:7899

# The public origin where the join page is served.
# This is the CF Worker URL (where web/ assets are deployed).
GG_JOIN_BASE_URL=https://WORKER_DOMAIN_HERE

# Gate the bot verifies against
GG_TG_GATE=crypt

# Public bridge URL (tunnel hostname) appended to join links as &bridge=URL.
# claim.js uses this to talk to the bridge from the CF Worker's domain.
GG_BRIDGE_PUBLIC_URL=https://BRIDGE_TUNNEL_DOMAIN_HERE

# Claim endpoint port (loopback, tunneled via cloudflared)
GG_TG_CLAIM_PORT=7808

# Live testnet mode (real Telegram membership changes)
GG_TG_LIVE_TESTNET=1

# ── Cloudflare Tunnel ───────────────────────────────────────────────────────
# These are not read by the Rust binaries. They configure cloudflared.
# See /opt/ghost-gate/etc/cloudflared-config.yml

# TUNNEL_TOKEN is set by cloudflared login / tunnel create.
# Store it in /opt/ghost-gate/etc/cloudflared-tunnel.json (0600 root:root).
