# Ghost Gate Telegram staging configuration.
# Permissions: 0640 owned by root:ghostgate-telegram.

# NEVER commit or log this token.
GG_TG_BOT_TOKEN=REPLACE_WITH_STAGING_BOT_TOKEN
GG_TG_CHAT_ID=REPLACE_WITH_STAGING_CHAT_ID

# The bridge is local; claims are exposed only through the restricted tunnel.
