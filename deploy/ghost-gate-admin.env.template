# Ghost Gate administrator dashboard — private VPS control plane.
# Permissions: 0640 owned by root:ghostgate-admin.
#
# Do not put wallet keys, browser sessions, or WebAuthn private keys here. Administrator
# credentials are public keys/passkey metadata in the registry; the browser retains private keys.

# Must be exactly loopback. Do not substitute 0.0.0.0 or a tunnel hostname.
GG_ADMIN_BIND=127.0.0.1:7811

# Open the dashboard locally after SSH forwarding with: http://localhost:7811
# Keeping this as localhost preserves WebAuthn's localhost relying-party behavior.
GG_ADMIN_HOSTNAME=localhost

# The shared, published-policy registry only. Replay state and bridge/Worker HMAC secrets remain
# outside this service's environment and data scope.
GG_ADMIN_DATA=/opt/ghost-gate/data/registry
