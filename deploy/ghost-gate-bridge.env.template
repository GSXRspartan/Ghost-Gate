# Ghost Gate bridge staging configuration.
# Permissions: 0640 owned by root:ghostgate-bridge.

# Loopback only; cloudflared supplies HTTPS ingress.
GG_BRIDGE_BIND=127.0.0.1:7799

# Exact Worker staging origin only. Browser query parameters never extend this list.
GG_BRIDGE_ORIGINS=https://WORKER_STAGING_DOMAIN_HERE
GG_BRIDGE_PERMITTED_HOSTS=bridge.STAGING_DOMAIN_HERE

# Registry-backed published staging policy and durable replay records.
GG_BINDINGS_PATH=/opt/ghost-gate/data/registry
GG_REPLAY_STORE_PATH=/opt/ghost-gate/data/replays

# Esmeralda Ootle testnet; no walletd runs on the VPS for Mode B.
GG_OOTLE_NETWORK=0x26
GG_INDEXER_ENDPOINT=https://OOTLE_INDEXER_ENDPOINT_HERE
GG_OPERATOR_TRUSTED_INDEXER=1
GG_MAX_TRUST_TIER=operator-trusted-testnet
GG_GATE_USE_CRYPT=both

# Authenticated Worker-to-bridge hosted verifier contract. Populate with
# staging-only values outside source control.
GG_VERIFIER_TOKEN=REPLACE_WITH_STAGING_VERIFIER_TOKEN
GG_VERIFIER_REQUEST_KEY=REPLACE_WITH_STAGING_VERIFIER_REQUEST_KEY
GG_VERIFIER_RESPONSE_KEY=REPLACE_WITH_STAGING_VERIFIER_RESPONSE_KEY
